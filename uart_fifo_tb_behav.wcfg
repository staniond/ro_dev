<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="top_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="top_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000 us"></ZoomStartTime>
      <ZoomEndTime time="2,001.000001 us"></ZoomEndTime>
      <Cursor1Time time="2,001.000000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="329"></NameColumnWidth>
      <ValueColumnWidth column_width="351"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="10" />
   <wvobject type="logic" fp_name="/top_tb/clk">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/top_tb/dip_switch">
      <obj_property name="ElementShortName">dip_switch[3:0]</obj_property>
      <obj_property name="ObjectShortName">dip_switch[3:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/top_tb/uart_rx">
      <obj_property name="ElementShortName">uart_rx</obj_property>
      <obj_property name="ObjectShortName">uart_rx</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/top_tb/uart_tx">
      <obj_property name="ElementShortName">uart_tx</obj_property>
      <obj_property name="ObjectShortName">uart_tx</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/top_tb/led1">
      <obj_property name="ElementShortName">led1</obj_property>
      <obj_property name="ObjectShortName">led1</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/top_tb/led2">
      <obj_property name="ElementShortName">led2</obj_property>
      <obj_property name="ObjectShortName">led2</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/top_tb/led3">
      <obj_property name="ElementShortName">led3</obj_property>
      <obj_property name="ObjectShortName">led3</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/top_tb/reset">
      <obj_property name="ElementShortName">reset</obj_property>
      <obj_property name="ObjectShortName">reset</obj_property>
   </wvobject>
   <wvobject type="other" fp_name="/top_tb/CLK_PERIOD">
      <obj_property name="ElementShortName">CLK_PERIOD</obj_property>
      <obj_property name="ObjectShortName">CLK_PERIOD</obj_property>
   </wvobject>
   <wvobject type="other" fp_name="/top_tb/BIT_PERIOD">
      <obj_property name="ElementShortName">BIT_PERIOD</obj_property>
      <obj_property name="ObjectShortName">BIT_PERIOD</obj_property>
   </wvobject>
</wave_config>
